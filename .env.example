# Local demo only — NEVER expose the API with hard-coded demo identity keys.
ROLEDOCK_MODE=demo
ROLEDOCK_PORT=8000

# offline (default, lexical demo) OR qdrant (real vector search)
ROLEDOCK_RETRIEVAL_MODE=offline
# If set, use a running Qdrant service (e.g. docker compose up -d qdrant).
# Without URL, Qdrant client uses a persistent local .qdrant directory.
# ROLEDOCK_QDRANT_URL=http://127.0.0.1:6333
ROLEDOCK_QDRANT_PATH=.qdrant
ROLEDOCK_QDRANT_COLLECTION=roledock_chunks_v1

# Actual LLM requests only. Standard Chat Completions-compatible API.
# Set these in a private .env or shell; never commit real credentials.
# ROLEDOCK_LLM_BASE_URL=https://your-provider.example/v1
# ROLEDOCK_LLM_MODEL=your-model-id
# ROLEDOCK_LLM_API_KEY=replace-with-your-private-key
# ROLEDOCK_ENABLE_AGENT_API=1

# LangGraph checkpoint hardening when persisting state.
LANGGRAPH_STRICT_MSGPACK=true
